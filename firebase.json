{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "predeploy": ["node tools/stamp-version.js"],
    "headers": [
      { "source": "**/*.@(js|css|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
